<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_property_api_key_list" model="ir.ui.view">
        <field name="name">property.api.key.list</field>
        <field name="model">property.api.key</field>
        <field name="arch" type="xml">
            <list string="API Keys">
                <field name="name"/>
                <field name="key"/>
                <field name="user_id"/>
                <field name="expiry_date"/>
                <field name="last_used"/>
                <field name="log_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_property_api_key_form" model="ir.ui.view">
        <field name="name">property.api.key.form</field>
        <field name="model">property.api.key</field>
        <field name="arch" type="xml">
            <form string="API Key">
                <sheet>
                    <div class="o_button_box" name="button_box">
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Calls"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Key label / name"/></h1>
                    </div>
                    <group>
                        <group string="Key">
                            <field name="key" readonly="1"/>
                            <button name="action_regenerate_key" string="Regenerate Key"
                                    type="object" class="btn-warning btn-sm mt-1"/>
                        </group>
                        <group string="Settings">
                            <field name="user_id"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="expiry_date"/>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="What is this key used for?"/>
                    </group>
                    <notebook>
                        <page string="Recent Logs">
                            <field name="log_ids" readonly="1">
                                <list limit="20">
                                    <field name="request_date"/>
                                    <field name="method"/>
                                    <field name="endpoint"/>
                                    <field name="response_code"/>
                                    <field name="ip_address"/>
                                    <field name="duration_ms"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_property_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">property.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first API key for mobile access</p>
        </field>
    </record>

</odoo>
