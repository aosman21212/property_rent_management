<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_property_property_list" model="ir.ui.view">
        <field name="name">property.property.list</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="code"/>
                <field name="name"/>
                <field name="property_type"/>
                <field name="owner_id"/>
                <field name="city"/>
                <field name="area"/>
                <field name="rent_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-info="status == 'rented'"
                       decoration-warning="status == 'maintenance'"
                       decoration-muted="status == 'inactive'"/>
            </list>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_property_property_kanban" model="ir.ui.view">
        <field name="name">property.property.kanban</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="property_type"/>
                <field name="owner_id"/>
                <field name="rent_amount"/>
                <field name="currency_id"/>
                <field name="status"/>
                <field name="city"/>
                <field name="area"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="image" widget="image" class="o_kanban_image me-2"
                                   options="{'img_class': 'rounded'}"/>
                            <div class="flex-grow-1 min-w-0">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="property_type"/> ·
                                    <field name="city"/>
                                </div>
                                <div>
                                    <b><field name="rent_amount" widget="monetary"
                                              options="{'currency_field': 'currency_id'}"/></b>
                                    / month
                                </div>
                                <div class="mt-1">
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'available'"
                                           decoration-info="status == 'rented'"
                                           decoration-warning="status == 'maintenance'"
                                           decoration-muted="status == 'inactive'"/>
                                </div>
                            </div>
                        </div>
                        <div class="text-muted small mt-1">
                            Owner: <field name="owner_id"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_property_property_form" model="ir.ui.view">
        <field name="name">property.property.form</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <form string="Rental Property">
                <header>
                    <button name="action_set_available" string="Set Available"
                            type="object" class="btn-secondary"
                            invisible="status == 'available'"/>
                    <button name="action_set_maintenance" string="Under Maintenance"
                            type="object" class="btn-warning"
                            invisible="status == 'maintenance'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,rented,maintenance,inactive"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label class="o_label_italic text-muted" for="code"/>
                        <h6><field name="code" readonly="1"/></h6>
                        <h1><field name="name" placeholder="Property Name"/></h1>
                    </div>
                    <div class="o_button_box" name="button_box">
                        <button name="action_view_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                        <button name="action_view_maintenance" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <group>
                        <group string="Property Details">
                            <field name="property_type"/>
                            <field name="owner_id"/>
                            <field name="furnished"/>
                            <field name="area"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                            <field name="floor"/>
                        </group>
                        <group string="Financial">
                            <field name="rent_amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Location">
                        <field name="address"/>
                        <field name="city"/>
                        <field name="country_id"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Property description..."/>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_property_property_search" model="ir.ui.view">
        <field name="name">property.property.search</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="code"/>
                <field name="owner_id"/>
                <field name="city"/>
                <separator/>
                <filter string="Available" name="available" domain="[('status','=','available')]"/>
                <filter string="Rented" name="rented" domain="[('status','=','rented')]"/>
                <filter string="Under Maintenance" name="maintenance"
                        domain="[('status','=','maintenance')]"/>
                <separator/>
                <filter string="Apartment" name="apartment"
                        domain="[('property_type','=','apartment')]"/>
                <filter string="Villa" name="villa" domain="[('property_type','=','villa')]"/>
                <filter string="Office" name="office" domain="[('property_type','=','office')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'property_type'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                    <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_property_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_property_property_search"/>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first rental property</p>
        </field>
    </record>

</odoo>
