<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_property_property" model="ir.sequence">
            <field name="name">Property Reference</field>
            <field name="code">property.property</field>
            <field name="prefix">PROP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_property_contract" model="ir.sequence">
            <field name="name">Rental Contract</field>
            <field name="code">property.contract</field>
            <field name="prefix">CONT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_property_maintenance" model="ir.sequence">
            <field name="name">Maintenance Request</field>
            <field name="code">property.maintenance</field>
            <field name="prefix">MNT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
